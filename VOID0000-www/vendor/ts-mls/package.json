      "optional": true
    },
    "@hpke/hybridkem-x-wing": {
      "optional": true
    },
    "@hpke/ml-kem": {
      "optional": true
    },
    "@hpke/dhkem-x448": {
      "optional": true
    },
    "@noble/curves": {
      "optional": true
    },
    "@noble/post-quantum": {
      "optional": true
    }
