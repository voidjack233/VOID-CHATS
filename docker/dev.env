EMAIL_PASS="your app password here"

# MinIO (Docker service)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=avatars
MINIO_GROUP_AVATAR_BUCKET=group-avatars
MINIO_ATTACH_BUCKET=chat-attachments

# Valkey (Docker service)
VALKEY_HOST=valkey
VALKEY_PORT=6379

# Phoenix gateway
GATEWAY_PORT=4001

# Optional MLS feature toggles exist in backend code, but they default to enabled.
# Leave them unset here unless you are explicitly testing disabled MLS behavior.