# Local Docker dev env.
# This keeps Docker-specific hosts/URLs, but otherwise follows the real backend env more closely.

# PostgreSQL (Docker service)
PGUSER=postgres
PGHOST=postgres
PGDATABASE=void-app
PGPASSWORD=void_dev_password
PGPORT=5432

# ScyllaDB (Docker service)
SCYLLA_HOST=scylla
SCYLLA_KEYSPACE=voidapp
SCYLLA_LOCAL_DATACENTER=datacenter1
SCYLLA_REPLICATION_FACTOR=1

# Browser-facing local URLs
# Docker's normal entrypoint is the Nginx edge service on localhost:8080.
# The Vite dev server still remains available on localhost:5173 for direct debugging.
BIND_HOST=0.0.0.0
FRONT_URL=http://localhost:8080
# Trust localhost plus Docker bridge/private-network proxies.
# The local Docker path is browser -> edge nginx -> backend services.
TRUST_PROXY=loopback,uniquelocal
VITE_API_URL=http://api:3001
VITE_CONVERSATION_API_URL=http://conversation-api:3005
VITE_MESSAGE_API_URL=http://message-api:3002
VITE_SOCIAL_API_URL=http://social-api:3004
VITE_GATEWAY_URL=ws://gateway:4001
CDN_URL=http://localhost:8080
MINIO_URL=http://localhost:9000
PORT=3001

# App secrets
# Dont use in production, but for local dev you can just leave them as-is.
ACCESS_SECRET='h9gq+BjPjBxzihnKsOfJsodreoAtWr5k+qAnU9Na+VAOWWCbZtaDsGNWDAo+vszl8kbFxvtS3kBHi3RELyoSQA=='
REFRESH_SECRET='XBp80Zx0jhmbGQewlakP+Sdtvhavj2knwRisOSic2b3FBSQNmjZzUclgsHzIiNS4uYOR5zeeyYzp+5BBeHVjrA=='
CSRF_ENCRYPTION_KEY='70PZ5Q6YGhK9Sa5Elv7HJschk2WFNAfnIvrp9ae1tDE='
TOTP_ENCRYPTION_KEY='8aeebf61cedb40306dcf89c22ab1ffc0df8218db12901b49d9ffeb0021b0fa84'
