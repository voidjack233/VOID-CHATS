# Local Docker dev env.
# This keeps Docker-specific hosts/URLs, but otherwise follows the real backend env more closely.

# PostgreSQL (Docker service)
PGUSER=postgres
PGHOST=postgres
PGDATABASE=void-app
PGPASSWORD=void_dev_password
PGPORT=5432

# ScyllaDB (Docker service)
SCYLLA_HOST=scylla
SCYLLA_KEYSPACE=voidapp
SCYLLA_LOCAL_DATACENTER=datacenter1
SCYLLA_REPLICATION_FACTOR=1

# Browser-facing local URLs
FRONT_URL=http://localhost:5173
VITE_API_URL=http://api:3001
VITE_GATEWAY_URL=ws://gateway:4001
CDN_URL=http://localhost:9000
MINIO_URL=http://localhost:9000
PORT=3001

# App secrets
# Rotate these periodically in production, but for local dev you can just leave them as-is.
