# Local Docker-only values. These are weak dev secrets, not production config.

# PostgreSQL
PGUSER=postgres
PGHOST=postgres
PGDATABASE=void-app
PGPASSWORD=void_dev_password
PGPORT=5432

# ScyllaDB
SCYLLA_HOST=scylla
SCYLLA_KEYSPACE=voidapp
SCYLLA_LOCAL_DATACENTER=datacenter1
SCYLLA_REPLICATION_FACTOR=1

# Frontend and API URLs
VITE_API_URL=http://api:3001
VITE_GATEWAY_URL=ws://gateway:4001
FRONT_URL=http://localhost:5173
PORT=3001

# JWT and encryption secrets. Replace these outside local Docker dev.
ACCESS_SECRET=local-dev-access-secret-change-me
REFRESH_SECRET=local-dev-refresh-secret-change-me
CSRF_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email
EMAIL_USER=replace-me@example.com
EMAIL_PASS=replace-me

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=avatars
MINIO_GROUP_AVATAR_BUCKET=group-avatars
MINIO_ATTACH_BUCKET=chat-attachments
CDN_URL=http://localhost:9000

# Valkey
VALKEY_HOST=valkey
VALKEY_PORT=6379

# Phoenix gateway
GATEWAY_PORT=4001
PHX_SECRET_KEY_BASE=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MLS flags
MLS_PROTOCOL_ENABLED=true
MLS_KEY_PACKAGES_ENABLED=true
MLS_GROUP_STATE_ENABLED=true
MLS_COMMIT_FANOUT_ENABLED=true
MLS_WELCOME_INBOX_ENABLED=true
