# PostgreSQL
PGUSER=postgres
PGHOST=127.0.0.1
PGDATABASE=void-app
PGPASSWORD=replace-me
PGPORT=5432

# ScyllaDB
SCYLLA_HOST=127.0.0.1

# Email
EMAIL_USER=replace-me@example.com
EMAIL_PASS=replace-me

# Frontend and API URLs
VITE_API_URL=http://localhost:3001
FRONT_URL=http://localhost:5173
PORT=3001
MESSAGE_SERVICE_PORT=3002
SOCIAL_SERVICE_PORT=3004
CONVERSATION_SERVICE_PORT=3005

# Express proxy trust.
# Use loopback for same-host nginx/cloudflared.
# Use loopback,uniquelocal for Docker edge nginx/private bridge networks.
TRUST_PROXY=loopback

# JWT secrets
ACCESS_SECRET=replace-with-base64-secret
REFRESH_SECRET=replace-with-base64-secret

# CSRF / 2FA encryption
CSRF_ENCRYPTION_KEY=replace-with-base64-key
TOTP_ENCRYPTION_KEY=replace-with-hex-key
TWO_FACTOR_CODE_SECRET=replace-with-random-secret

# MinIO
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=avatars
MINIO_GROUP_AVATAR_BUCKET=group-avatars
MINIO_ATTACH_BUCKET=chat-attachments
CDN_URL=http://127.0.0.1:9000

# Valkey
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379

# Phoenix gateway
GATEWAY_PORT=4001
PHX_SECRET_KEY_BASE=replace-with-mix-phx-gen-secret

VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=https://void0000.online
